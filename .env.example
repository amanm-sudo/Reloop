# ReLoop environment variables.
# Copy to .env.local and fill in. Never commit .env.local. See .kiro/steering/secrets.md.

# --- Database ---
# MongoDB Atlas connection string. Create a free M0 cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/reloop?retryWrites=true&w=majority
# Database name used by the app and the seed script.
MONGODB_DB=reloop

# --- Models ---
# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
# Leave EMPTY to run entirely on deterministic fixtures — the app works without it.
GEMINI_API_KEY=
# Model used for reasoning, justifications and negotiation turns.
GEMINI_MODEL=gemini-2.5-flash
# Vision model used by the Perception Agent. Gemini Flash is multimodal, so this is usually the same.
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Auth ---
# JWT signing secret, minimum 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_OF_RANDOM

# --- Telegram (Days 11-12) ---
# Token from @BotFather. Create the bot on day 0 to remove approval risk.
TELEGRAM_BOT_TOKEN=
# Random string sent as X-Telegram-Bot-Api-Secret-Token and verified on the webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Routing / maps ---
# OSRM routing endpoint. The public demo server is rate-limited; self-host for reliability.
OSRM_BASE_URL=https://router.project-osrm.org
# Public map style URL. Not a secret.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Behaviour flags ---
# true = agent model calls resolve from deterministic fixtures. Orchestration path is identical.
DEMO_MODE=true
# true = the Negotiation Agent may contact a real external organisation. MUST stay false.
ALLOW_REAL_OUTREACH=false

# --- Cron ---
# Shared secret checked by /api/cron/tick so the sweep cannot be triggered by anyone.
CRON_SECRET=REPLACE_ME
